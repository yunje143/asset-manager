# このファイルを .streamlit/secrets.toml としてコピーし、実際の値を設定してください。
# secrets.toml は絶対にコミットしないこと（.gitignore 済み）。
#
# Google 認証について: このアプリは Application Default Credentials (ADC) を使うため、
# サービスアカウントの鍵ファイルは一切不要です。
#   - Cloud Run: `gcloud run deploy --service-account=<SA email> ...` でアタッチすれば自動的に認証される
#   - ローカル開発: 一度だけ
#       gcloud auth application-default login --impersonate-service-account=<SA email>
#     を実行しておけば、このファイルに認証情報を書かなくても動作する
# 詳細は docs/architecture.md を参照。

[sheets]
spreadsheet_id = "your-google-spreadsheet-id"
transactions_worksheet = "transactions"
ticker_map_worksheet = "ticker_map"

[app]
debug = false
